NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only secrets. Never prefix them with NEXT_PUBLIC_ and never commit real values.
# Super-admin console (/admin): password (12+ characters) and the Supabase service-role key used only to unlock it.
ADMIN_CONSOLE_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=
# AI receipt and photo scanning. Set ONE of these: Groq has a free tier, Anthropic is more accurate (used first when both are set).
GROQ_API_KEY=
# Optional: override the Groq vision model (default qwen/qwen3.8-27b)
# GROQ_VISION_MODEL=
ANTHROPIC_API_KEY=
# Monthly statement emails (nodemailer over SMTP). Gmail example: smtp.gmail.com, port 465, an App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="FairShare <you@example.com>"
# Shared secret (24+ random characters) that lets the daily Worker trigger run the statement job.
CRON_SECRET=
